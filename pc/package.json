{
    "name": "nextrade",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node scripts/patch-next-trace.mjs",
        "dev": "cross-env PC_SKIP_BUILD_TRACE=1 next dev -p 3006",
        "prebuild": "node scripts/patch-next-trace.mjs",
        "build": "cross-env PC_SKIP_BUILD_TRACE=1 next build",
        "start": "next start -p 3006",
        "typecheck": "tsc -p tsconfig.react.json --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
    },
    "dependencies": {
        "@douyinfe/semi-icons": "^2.104.0",
        "@douyinfe/semi-ui": "^2.104.0",
        "i18next": "^26.7.1",
        "next": "^14.2.15",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^17.1.12"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "cross-env": "^10.1.0",
        "prettier": "3.5.3",
        "typescript": "5.9.3"
    }
}

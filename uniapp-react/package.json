{
    "name": "uniapp-react",
    "version": "1.0.0",
    "private": true,
    "description": "NexTrade 移动端 React 实现（Taro 4 + React 18 + NutUI-React）",
    "scripts": {
        "dev:weapp": "taro build --type weapp --watch",
        "build:weapp": "taro build --type weapp",
        "dev:h5": "taro build --type h5 --watch",
        "build:h5": "taro build --type h5",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "browserslist": [
        "last 3 versions",
        "Android >= 4.1",
        "ios >= 8"
    ],
    "dependencies": {
        "@babel/runtime": "^7.24.4",
        "@nutui/nutui-react-taro": "3.0.20",
        "@tarojs/components": "4.3.2",
        "@tarojs/helper": "4.3.2",
        "@tarojs/plugin-framework-react": "4.3.2",
        "@tarojs/plugin-platform-h5": "4.3.2",
        "@tarojs/plugin-platform-weapp": "4.3.2",
        "@tarojs/react": "4.3.2",
        "@tarojs/runtime": "4.3.2",
        "@tarojs/shared": "4.3.2",
        "@tarojs/taro": "4.3.2",
        "crypto-js": "^4.1.1",
        "dayjs": "^1.11.11",
        "gcoord": "^1.0.7",
        "i18next": "^26.7.1",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-i18next": "^17.1.12",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@babel/preset-react": "^7.29.7",
        "@tarojs/cli": "4.3.2",
        "@tarojs/webpack5-runner": "4.3.2",
        "@testing-library/react": "^14.3.1",
        "@types/crypto-js": "^4.2.2",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@types/webpack-env": "^1.13.6",
        "babel-preset-taro": "4.3.2",
        "jsdom": "^24.1.3",
        "typescript": "^5.4.0",
        "vitest": "^1.6.1",
        "webpack": "^5.91.0"
    }
}